# build output
/target/
/dist/

# ROM dumps, saves and firmware blobs are never committed (commercial games, unknown rights):
# keep only the checksums so that anyone can check their own dumps.
/dumps/*
!/dumps/SHA1SUMS
*.gb
*.gbc
*.gba
*.sav
*.md.rom
*.bin

# editor / OS
*~
.DS_Store

# videos and screen recordings (kept for the store listing, never committed)
*.MOV
*.mov
*.mp4
